# Database
DATABASE_URL=sqlite:///./studymate.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/studymate

# Security & JWT
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Providers
LLM_PROVIDER=gemini
LLM_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=

# Storage
FILE_STORAGE=local
STORAGE_BUCKET_URL=
UPLOAD_DIR=uploads
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=75
